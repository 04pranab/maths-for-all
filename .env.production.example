# Production deployment template.
# Fill these values in the deployment environment, never in Git.

AUTH_PORT=8080
AUTH_DB_PATH=/var/lib/maths-for-all/maths-for-all.sqlite
AUTH_SESSION_TTL_SECONDS=28800
AUTH_ORIGIN=https://your-domain.example
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=
AUTH_EMAIL_FROM=

# Required when the managed PostgreSQL migration is deployed.
DATABASE_URL=

AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
