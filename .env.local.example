# Local development template.
# cp .env.local.example .env.local
# set -a; source .env.local; set +a
#
# Real credentials belong in .env.local, never in Git.

AUTH_PORT=8080
AUTH_DB_PATH=./data/maths-for-all.sqlite
AUTH_SESSION_TTL_SECONDS=28800
AUTH_ORIGIN=http://127.0.0.1:8080
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=
AUTH_EMAIL_FROM=

# Fill this only when the PostgreSQL migration is being tested locally.
DATABASE_URL=

AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
