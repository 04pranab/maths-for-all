AUTH_PORT=8080
AUTH_SESSION_TTL_SECONDS=28800
AUTH_ORIGIN=http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false

# Put your Supabase PostgreSQL connection string here.
# Keep this file local and never commit it.
DATABASE_URL=
DATABASE_POOL_MAX=5

# Leave these empty until email delivery is configured.
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=
AUTH_EMAIL_FROM=

# Leave these empty until Google OAuth is configured.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
